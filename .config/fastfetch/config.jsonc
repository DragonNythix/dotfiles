{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/ascii.txt",
    "color": {
      "1": "#FCF434",
      "2": "#FFFFFF",
      "3": "#9C59D1",
      "4": "#2C2C2C"
    },
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "#F5C2E7",
        "at": "#CDD6F4",
        "host": "#89DCEB"
      }
    },
    "break",
    {
      "type": "os",
      "key": "",
      "keyColor": "#89DCEB"
    },
    {
      "type": "kernel",
      "key": "",
      "keyColor": "white"
    },
    {
      "type": "packages",
      "key": "",
      "keycolor": "white"
    },
    {
      "type": "uptime",
      "key": "",
      "keyColor": "white"
    },
    {
      "type": "cpu",
      "key": "",
      "keyColor": "#F5C2E7"
    },
    {
      "type": "gpu",
      "key": "",
      "keyColor": "#F5C2E7"
    },
    {
      "type": "memory",
      "key": "",
      "keyColor": "#A6E3A1",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "disk",
      "key": "",
      "keyColor": "#94E2D5"
    },
    {
      "type": "terminal",
      "key": "",
      "keyColor": "blue"
    },
    {
      "type": "shell",
      "key": "",
      "keyColor": "blue"
    },
    {
      "type": "wm theme",
      "key": "󰔎",
      "keyColor": "blue"
    },
    {
      "type": "theme",
      "key": "󰔎",
      "keyColor": "blue"
    },
    {
      "type": "icons",
      "key": "",
      "keyColor": "blue"
    },
    {
      "type": "font",
      "key": "",
      "keyColor": "blue"
    },
    {
      "type": "locale",
      "key": "",
      "keyColor": "blue"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
